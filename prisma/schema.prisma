generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// test
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Relationships
  boards    Board[] // ผู้ใช้คนนี้เป็นเจ้าของบอร์ดอะไรบ้าง
  tasks     Task[] // ผู้ใช้คนนี้ได้รับมอบหมายงานอะไรบ้าง (Assignee)
}

model Board {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Relationships
  userId      Int // Foreign Key ของเจ้าของบอร์ด
  user        User     @relation(fields: [userId], references: [id])
  tasks       Task[] // ในบอร์ดนี้มีงานอะไรบ้าง
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(TODO) // ใช้ Enum แทน String
  priority    TaskPriority @default(LOW)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  // Relationships 1: งานนี้อยู่บนบอร์ดไหน 
  boardId     Int
  board       Board        @relation(fields: [boardId], references: [id])
  // Relationships 2: ใครรับผิดชอบงานนี้ (Optional - งานอาจจะยังไม่มีคนทำก็ได้)
  userId      Int?
  user        User?        @relation(fields: [userId], references: [id])
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
